# --- CONFIGURAÇÕES DE SEGURANÇA ---
# Em produção, DEBUG deve ser False
DEBUG=False
SECRET_KEY=gere_uma_chave_aleatoria_e_complexa_aqui_para_producao

# --- DOMÍNIOS E CORS ---
# Permite o domínio Arasaka e localhost (para o túnel funcionar)
ALLOWED_HOSTS=.arasaka.fun,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://financeiro-une.arasaka.fun
CSRF_TRUSTED_ORIGINS=https://financeiro-une.arasaka.fun

# --- BANCO DE DADOS ---
POSTGRES_DB=demolay_db
POSTGRES_USER=demolay_user
POSTGRES_PASSWORD=senha_segura_do_banco_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://demolay_user:senha_segura_do_banco_prod@db:5432/demolay_db

# --- FRONTEND ---
# O navegador do usuário vai bater neste endereço HTTPS
NEXT_PUBLIC_API_URL=https://financeiro-une.arasaka.fun/api
