# --- CONFIGURAÇÕES DE SEGURANÇA ---
# Mude para False em produção!
DEBUG=False
SECRET_KEY=sua_chave_secreta_super_complexa_aqui

# --- DOMÍNIOS E CORS ---
ALLOWED_HOSTS=.arasaka.fun,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://financeiro-une.arasaka.fun
CSRF_TRUSTED_ORIGINS=https://financeiro-une.arasaka.fun

# --- BANCO DE DADOS (Mantém igual) ---
POSTGRES_DB=demolay_db
POSTGRES_USER=demolay_user
POSTGRES_PASSWORD=senha_segura_do_banco
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://demolay_user:senha_segura_do_banco@db:5432/demolay_db

# --- FRONTEND (A Mágica Acontece Aqui) ---
# O Frontend agora vai bater no domínio público, usando HTTPS
NEXT_PUBLIC_API_URL=https://financeiro-une.arasaka.fun/api